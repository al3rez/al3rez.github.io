---
import { getCollection } from "astro:content";
import AsciiLogo from "../components/ascii-logo.astro";
import EmailLink from "../components/email-link.astro";
import Layout from "../components/layout.astro";
import getPostDate from "../lib/get-post-date";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.unlisted)
  .sort((a, b) => getPostDate(b).getTime() - getPostDate(a).getTime());
---

<Layout
  title="al3rez"
  description="Alireza Bashiri is a founding AI engineer at Humano.ai, working on RAG, AI avatar generation, low latency realtime systems, and agentic workflows."
>
  <main>
    <AsciiLogo />

    <p>
      I'm Alireza Bashiri. I'm currently a founding AI engineer at <a href="https://humano.ai">humano.ai</a>, where I work on RAG, AI avatar generation, low latency realtime systems, and agentic workflows. We're building <a href="https://livetwin.ai">livetwin.ai</a> and a bunch of other AI products.
    </p>

    <p>
      I also founded <a href="https://admix.software">admix.software</a>, <a href="https://astromvp.com">astromvp.com</a>, <a href="https://adworthy.ai">adworthy.ai</a>, and a few other projects.
    </p>

    <nav aria-label="Posts">
      {
        posts.map((post) => {
          const postDate = getPostDate(post);
          const iso = postDate.toISOString().slice(0, 10);

          return (
            <p>
              <a class="datelink" href={`/${post.slug}`}>
                <time datetime={iso}>{iso}</time>
              </a>{" "}
              {post.data.title}
            </p>
          );
        })
      }
    </nav>
  </main>
  <hr />
  <footer class="site-footer" aria-label="Site footer">
    <a href="https://github.com/al3rez" rel="me">github.com/al3rez</a>
    <a href="https://twitter.com/al3rez" rel="me">twitter.com/al3rez</a>
    <EmailLink />
  </footer>
</Layout>
