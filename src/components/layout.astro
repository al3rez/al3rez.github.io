---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
  headline?: string;
}

import "../css/style.css";

const {
  title,
  description = "Writing about software, systems, and the craft of building things.",
  image = "/me.jpg",
  type = "website",
  publishedTime,
  noindex = false,
  headline,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();

const person = {
  "@type": "Person",
  name: "Alireza Bashiri",
  alternateName: "al3rez",
  url: "https://al3rez.com",
  image: new URL("/me.jpg", Astro.site).toString(),
  jobTitle: "Founding AI Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Humano.ai",
    url: "https://humano.ai",
  },
  sameAs: ["https://github.com/al3rez", "https://twitter.com/al3rez"],
};

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: headline ?? title,
        description,
        datePublished: publishedTime,
        dateModified: publishedTime,
        author: person,
        publisher: person,
        image: ogImage,
        url: canonical,
        mainEntityOfPage: canonical,
      }
    : {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            name: "al3rez",
            url: "https://al3rez.com",
            author: person,
          },
          person,
        ],
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alireza Bashiri" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="al3rez" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === "article" && (
        <meta property="article:author" content="Alireza Bashiri" />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@al3rez" />
    <meta name="twitter:site" content="@al3rez" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/atom+xml"
      title="al3rez atom feed"
      href="/atom.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="al3rez rss feed"
      href="/rss"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
